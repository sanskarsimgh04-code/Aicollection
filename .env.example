# ==============================================================================
# A1 Collection - Environment Configuration Foundation
# ==============================================================================

# Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL, Auth, Storage)
# ------------------------------------------------------------------------------
# Public credentials (accessible to browser client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-only credentials (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# Payment & Checkout Mode Architecture
# ------------------------------------------------------------------------------
# Allowed values: MANUAL_CONFIRMATION | ONLINE_PAYMENT | BOTH
# Default primary mode: MANUAL_CONFIRMATION (Customer places order -> Created as awaiting confirmation -> Owner contacts customer -> Confirmed -> Packed -> Out for delivery -> Delivered)
PAYMENT_MODE="MANUAL_CONFIRMATION"
VITE_PAYMENT_MODE="MANUAL_CONFIRMATION"

# ------------------------------------------------------------------------------
# Rate Limiting & Security (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ------------------------------------------------------------------------------
# Transactional Email & Notifications
# ------------------------------------------------------------------------------
# Service provider API key for transactional emails (e.g., order notifications)
EMAIL_PROVIDER_API_KEY="re_your_transactional_email_key"
ADMIN_NOTIFICATION_EMAIL="owner@a1collection.com"
ADMIN_WHATSAPP_PHONE="+10000000000"

# ------------------------------------------------------------------------------
# Server-side AI Integration (Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key"

# ------------------------------------------------------------------------------
# Privacy-Conscious Analytics
# ------------------------------------------------------------------------------
ANALYTICS_ENABLED="false"
